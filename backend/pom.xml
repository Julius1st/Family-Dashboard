<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.familydashboard</groupId>
  <artifactId>backend</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>backend</name>
  <description>Family Dashboard backend</description>

  <properties>
    <java.version>25</java.version>
  </properties>

  <!--
    For OpenMeteoWeatherProviderTest's org.wiremock:wiremock-jetty12 test
    dependency (see its comment below): wiremock-jetty12's own POM manages
    Jetty at 12.0.16 (importing org.eclipse.jetty:jetty-bom and
    org.eclipse.jetty.ee10:jetty-ee10-bom at that version), but
    spring-boot-starter-parent's own dependency management - inherited by
    every dependency in this project, including test-scoped ones - manages
    plain org.eclipse.jetty:jetty-bom (not the ee10 one) at 12.1.12, and a
    project's own effective dependency management always wins over a
    transitive dependency's, per Maven's dependency mediation rules. That
    left jetty-server et al. resolved to 12.1.12 while jetty-ee10-servlet
    et al. stayed at 12.0.16 - two incompatible Jetty release lines on the
    same classpath, which broke WireMock's server startup with
    NoSuchMethodError/NoClassDefFoundError (confirmed by running the tests
    and inspecting `mvn dependency:tree`). Importing jetty-ee10-bom at
    12.1.12 explicitly (confirmed present on Maven Central) re-aligns it
    with the jetty-bom version Spring Boot already forces, without
    touching any of this project's actual production dependencies.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.eclipse.jetty.ee10</groupId>
        <artifactId>jetty-ee10-bom</artifactId>
        <version>12.1.12</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      For OpenMeteoWeatherProviderTest: CLAUDE.md's own convention requires
      WireMock (never the live API) for testing external-API provider
      classes like OpenMeteoWeatherProvider. `org.wiremock:*` (not the
      older `com.github.tomakehurst` groupId, retired after WireMock 3.0)
      is the current Maven Central home. Version 3.13.1 is the latest
      stable release as of this writing (checked via the Maven Central
      search API; the only newer releases are 4.0.0-beta.* pre-releases).

      WireMock 3.x split its embedded HTTP server out of the core
      `wiremock` artifact into a separate pluggable engine module - plain
      `wiremock` alone throws "no suitable HttpServerFactory extension was
      found" at server startup. `wiremock-jetty12` is that engine, and its
      own POM (checked on Maven Central) pulls in `wiremock` core itself
      transitively, with its Jetty-11-era transitive dependencies excluded
      in favour of a consistent, matched set of Jetty 12 modules - so this
      is the *only* WireMock dependency to declare directly: adding bare
      `wiremock` alongside it (tried first) produced two different Jetty
      major versions on the classpath simultaneously and broke server
      startup with NoClassDefFoundError. Deliberately not
      `wiremock-standalone` (a shaded fat jar meant for running WireMock as
      a separate out-of-process server, not embedding) or
      `spring-cloud-contract-wiremock` (a thin wrapper pulling in the much
      heavier Spring Cloud dependency tree for a feature this project
      doesn't need).
    -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-jetty12</artifactId>
      <version>3.13.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Activates the "test" Spring profile for every `mvn test` run, no
        per-test-class annotation needed. This is what makes
        src/test/resources/application-test.yml's overrides (currently just
        weather.cache.initial-delay-millis, see WeatherCache) apply
        automatically to every @SpringBootTest in this module.

        NOT a same-named src/test/resources/application.yml: verified
        empirically (a throwaway ApplicationContextRunner-based probe, since
        removed) that Spring Boot's default classpath:/application.yml
        config-data location resolves to a SINGLE resource, not a merge of
        every same-named classpath entry - Maven Surefire's test-classes
        precedes classes on the runtime classpath, so a same-named
        src/test/resources/application.yml would silently REPLACE (not
        layer on top of) src/main/resources/application.yml, dropping
        household.members, weather.latitude/longitude, and the datasource
        config entirely during every test run. Profile-specific documents
        (application-<profile>.yml) don't have that problem - they're
        additively layered over the base application.yml by design, which
        is the actual, correctly-documented Spring Boot mechanism for a
        test-only partial override like this one.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <spring.profiles.active>test</spring.profiles.active>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <!--
        Frontend bundling (Phase 4 Ticket 1): run `npm run build` (ng build)
        against the Angular app in ../frontend, then copy its compiled output
        onto this jar's classpath under static/, so Spring Boot's default
        static-resource handling serves index.html and the JS/CSS bundles.

        NOTE ON TOOLING HISTORY: this originally used `exec-maven-plugin`,
        invoking whatever `npm` happened to be on PATH, because this
        container's firewall was believed to block nodejs.org (the source
        frontend-maven-plugin's `install-node-and-npm` goal downloads from).
        That belief turned out to be wrong - nodejs.org is in fact reachable
        here - so this now uses `frontend-maven-plugin`'s normal, fully
        supported install-node-and-npm + npm goals, downloading a pinned
        Node/npm rather than depending on whatever happens to be
        preinstalled. That makes `./mvnw clean package` self-contained: it
        no longer implicitly requires Node on PATH, which matters for
        Ticket 2's Dockerfile build stage and any future CI job that builds
        a release jar without Node preinstalled.

        (The investigation into whether frontend-maven-plugin could be
        pointed at an *existing* system Node install - decompiling its
        `npm`/`node` goals across the latest 1.x and 2.x releases, 1.15.4
        and 2.0.2 - found no supported way to do that: neither exposes an
        `npmExecutable`/`nodeExecutable` override, and both goals only
        resolve node/npm from the `<installDirectory>/node/node` layout
        that only `install-node-and-npm`'s own download produces. That's
        moot now that the plugin is allowed to actually download, but is
        why this didn't use frontend-maven-plugin from the start.)

        1.15.4 (a mature, widely-used release already inspected in depth
        above) is pinned here rather than the newer 2.0.x line, which
        hasn't been exercised in this project.

        Node version: v24.20.0, the latest Node 24 ("Krypton") LTS point
        release as of this writing - satisfies both frontend-ci.yml's
        Node 24.x pin (Phase 2 Ticket 2) and @angular/cli's own
        engines.node range (^22.22.3 || ^24.15.0 || >=26.0.0). npmVersion
        is set to `provided`, the plugin's own convention for "use the npm
        bundled with the downloaded Node" (11.19.0 for this Node build)
        rather than fetching npm separately.
      -->
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>1.15.4</version>
        <configuration>
          <workingDirectory>${project.basedir}/../frontend</workingDirectory>
          <installDirectory>${project.build.directory}/frontend-toolchain</installDirectory>
        </configuration>
        <executions>
          <execution>
            <id>install-node-and-npm</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>install-node-and-npm</goal>
            </goals>
            <configuration>
              <nodeVersion>v24.20.0</nodeVersion>
              <npmVersion>provided</npmVersion>
            </configuration>
          </execution>
          <execution>
            <!--
              `npm run build` invokes `ng build` via package.json's build
              script, and `ng` only resolves from node_modules/.bin/ng -
              which doesn't exist until dependencies are installed. This
              execution must run (and be declared, since same-phase
              executions run in declaration order) before npm-build-frontend
              below. `npm ci` (not `npm install`) for a reproducible install
              straight from package-lock.json, matching frontend-ci.yml.
            -->
            <id>npm-install-frontend</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>ci</arguments>
            </configuration>
          </execution>
          <execution>
            <id>npm-build-frontend</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>run build</arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Copy the Angular build output onto the jar's classpath under static/.
        Modern Angular CLI (application builder) writes ng build's output to
        dist/frontend/browser/ (index.html, hashed JS/CSS, favicon), with
        dist/frontend/ itself holding only build metadata
        (3rdpartylicenses.txt, prerendered-routes.json) - confirmed by
        running the build directly and inspecting the resulting tree, rather
        than assuming the older dist/frontend/ convention.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>copy-frontend-static</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../frontend/dist/frontend/browser</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
